{
  "name": "shakti-panchang",
  "private": true,
  "version": "1.2.1",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "build:android": "npm run build && npx cap sync android",
    "cap:sync": "npx cap sync android",
    "cap:copy": "npx cap copy android",
    "lint": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@google/genai": "^2.21.0",
    "astronomy-engine": "^2.1.19",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
